# .env.prod.example — copie para .env.prod na VM e preencha os valores reais
# NUNCA commitar o .env.prod (está no .gitignore)
#
# Gerar JWT_SECRET_KEY forte (rodar local antes de subir):
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── OCIR ────────────────────────────────────────────────────────────────────
# Namespace do Object Storage (OCI console → Tenancy → Object Storage Namespace)
OCIR_NAMESPACE=seu_namespace_aqui

# ── JWT ─────────────────────────────────────────────────────────────────────
# Segredo forte — mínimo 32 chars, alta entropia. NÃO usar o valor de dev.
JWT_SECRET_KEY=SUBSTITUA_POR_TOKEN_HEX_32_CHARS

# ── Oracle Autonomous DB ─────────────────────────────────────────────────────
ORACLE_DB_PASSWORD=SUBSTITUA_PELA_SENHA_DO_ADMIN_ADB

# Senha da wallet (definida ao baixar o zip no console OCI)
ORACLE_WALLET_PASSWORD=SUBSTITUA_PELA_SENHA_DA_WALLET

# Caminho ABSOLUTO da wallet na VM (ex: /home/ubuntu/wallet)
# ⚠️  NÃO usar ~ nem caminhos relativos — o compose não expande ~ em volumes
WALLET_DIR=/home/ubuntu/wallet
