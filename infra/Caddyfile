# GoldBlack — Caddy reverse proxy

# ── HTTPS (produção) ──────────────────────────────────────────────────────────
# Caddy obtém e renova o certificado Let's Encrypt automaticamente.
# Pré-requisito: goldblackcoffee.duckdns.org → 204.216.129.119 (DuckDNS)
#                portas 80 e 443 abertas na OCI Security List

goldblackcoffee.duckdns.org {
    # HSTS: força HTTPS por 1 ano após primeira visita
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    handle /api/* {
        uri strip_prefix /api
        reverse_proxy backend:8000
    }
    handle {
        reverse_proxy frontend:80
    }
}

# Redireciona qualquer request HTTP → HTTPS permanentemente
:80 {
    redir https://{host}{uri} permanent
}
